test_function <- function(num1, num2){
result = num1 + num2
return(result)
}
rm(test_function)
library(devtools)
load_all()
test_function(num1 = 5, num2 = 6)
document()
load_all()
?test_function
check()
usethis::use_mit_license()
document()
load_all()
check()
remotes::install_github("fosternc8/nicoleexamplepackage")
remotes::install_github("fosternc8/nicoleexamplepackage")
library(nicoleexamplepackage)
test_function(3, 5)
remotes::install_github("fosternc8/nicoleexamplepackage", force = TRUE)
remotes::install_github("fosternc8/nicoleexamplepackage", force = TRUE)
